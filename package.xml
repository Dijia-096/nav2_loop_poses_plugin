<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav2_loop_poses_plugin</name>
  <version>0.0.0</version>
  <description>LoopPoses BT node: continuously cycles through waypoints for patrol navigation</description>
  <maintainer email="wfs@todo.todo">wfs</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>behaviortree_cpp_v3</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>nav2_util</build_depend>
  <build_depend>nav2_common</build_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>behaviortree_cpp_v3</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav2_util</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
